.data
cadeia: .asciz "banana"
.align 2
resultado:  .word 0

.text 
.globl main
main:

la a0,cadeia #endereço da cadeia=a0
li a1,'a'  #define o caracter a prourar
jal ra,contar_char #chama a sub-rotina

la t0,resultado
sw a0,0(t0)

li a7,1
ecall 

li a7,10
ecall 

# a0 = endereço da cadeia
# a1 = caracter a procurar
# Retorna em a0 o número de vezes que aparece o caracter

contar_char:
mv t0,a0
li t2,0

contar_char_loop:
lb t3, 0(t0)
beq t3,zero,contar_char_fim
bne t3,a1,contar_char_seguinte
addi t2,t2,1

contar_char_seguinte:
addi t0, t0, 1

j contar_char_loop

contar_char_fim:
mv a0,t2
ret

