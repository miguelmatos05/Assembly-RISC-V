.data

v_byte: .byte -8, -3, -12, -1
.align 2
resultado: .word 0

.text 
.globl main
main:

la a0,v_byte
li a1,4

jal ra, max_byte

la t0,resultado
sw a0,0(t0)
 
 li a7, 1
ecall

li a7, 10
ecall



# a0 = endereço do vetor
# a1 = número de elementos >= 1
# Retorna em a0 o máximo, com sinal

max_byte:
lb t0, 0(a0) #Máximo = primeiro elemento
addi t1, a0, 1 #Endereço do elemento seguinte
addi t2, a1, -1 #Elementos por analisar

max_byte_loop:
beq t2, zero, max_byte_fim

lb t3,0(t1) #Carrega o elemento seguinte 
bge t0,t3, max_byte_seguinte
mv t0,t3 #Novo máximo 

max_byte_seguinte:
addi  t1,t1,1
addi t2,t2,-1

j max_byte_loop

max_byte_fim:

mv  a0,t0
ret 
